# Copy this to .env and fill in your keys
# Never commit .env to git

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# beehiiv auth state — generated by running: python auth_setup.py
# Supports any login method (Google, Apple, email, etc.) — no password needed
# In GitHub Actions: add the base64 output as Secret BEEHIIV_AUTH_STATE
# Locally: auth_state.json is loaded automatically (gitignored)
BEEHIIV_AUTH_STATE=

# Firecrawl - https://firecrawl.dev (free tier: 500 pages)
FIRECRAWL_API_KEY=fc-...

# Active city slug (must match a folder in cities/)
CITY_SLUG=boise

# Human approval: "local" saves draft to disk, "email" emails you, "none" = autopilot
HUMAN_APPROVAL=none

# Email settings (only needed if HUMAN_APPROVAL=email)
APPROVAL_EMAIL_TO=you@example.com
APPROVAL_EMAIL_FROM=newsletter@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
