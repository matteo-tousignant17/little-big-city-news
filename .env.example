# Copy this to .env and fill in your keys
# Never commit .env to git

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# beehiiv login credentials — used for browser-based publishing (no paid API tier needed)
# Add these as GitHub Secrets: BEEHIIV_EMAIL and BEEHIIV_PASSWORD
BEEHIIV_EMAIL=you@example.com
BEEHIIV_PASSWORD=your_beehiiv_password
# BEEHIIV_API_KEY is no longer required (kept only if you use the --publish CLI manually)

# Firecrawl - https://firecrawl.dev (free tier: 500 pages)
FIRECRAWL_API_KEY=fc-...

# Active city slug (must match a folder in cities/)
CITY_SLUG=boise

# Human approval: "local" saves draft to disk, "email" emails you, "none" = autopilot
HUMAN_APPROVAL=none

# Email settings (only needed if HUMAN_APPROVAL=email)
APPROVAL_EMAIL_TO=you@example.com
APPROVAL_EMAIL_FROM=newsletter@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
